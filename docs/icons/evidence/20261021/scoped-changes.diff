+program DACComponentsInteractionCurrent;
+
+{$APPTYPE CONSOLE}
+{$MINSTACKSIZE $00200000}
+
+uses
+  DACComponentsIcons.Tests in 'DACComponentsIcons.Tests.pas',
+  System.Classes,
+  System.SysUtils,
+  System.TypInfo,
+  Winapi.Messages,
+  Winapi.Windows,
+  Vcl.Controls,
+  Vcl.Forms,
+  Vcl.Graphics,
+  Vcl.Mask,
+  Vcl.StdCtrls,
