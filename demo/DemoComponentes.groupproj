<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{27D279D8-7B84-4414-A5FD-FDA65B69ED76}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\Package\DACSkiaComponents.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Demo.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="DACSkiaComponents">
        <MSBuild Projects="..\Package\DACSkiaComponents.dproj"/>
    </Target>
    <Target Name="DACSkiaComponents:Clean">
        <MSBuild Projects="..\Package\DACSkiaComponents.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DACSkiaComponents:Make">
        <MSBuild Projects="..\Package\DACSkiaComponents.dproj" Targets="Make"/>
    </Target>
    <Target Name="Demo">
        <MSBuild Projects="Demo.dproj"/>
    </Target>
    <Target Name="Demo:Clean">
        <MSBuild Projects="Demo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Demo:Make">
        <MSBuild Projects="Demo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="DACSkiaComponents;Demo"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="DACSkiaComponents:Clean;Demo:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="DACSkiaComponents:Make;Demo:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
