    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAppDataBaseDir)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAppDataBaseDir)\UserTools.proj')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
    <PropertyGroup>
        <DAC_ProvenanceOutput>..\Build\Provenance\$(MSBuildProjectName)\$(Platform)\$(Config)</DAC_ProvenanceOutput>
        <BuildDependsOn>$(BuildDependsOn);WriteDacBuildProvenance</BuildDependsOn>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win32)'!=''">
        <Cfg_1_Win32>true</Cfg_1_Win32>
        <CfgParent>Cfg_1</CfgParent>
        <Cfg_1>true</Cfg_1>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_CBuilderOutput>None</DCC_CBuilderOutput>
        <DCC_DcpOutput>..\Build\Dcp\$(Platform)\$(Config)</DCC_DcpOutput>
        <DCC_BplOutput>..\Build\Bpl\$(Platform)\$(Config)</DCC_BplOutput>
        <DCC_DcuOutput>..\Build\Dcu\$(Platform)\$(Config)\DACSkiaComponents</DCC_DcuOutput>
        <DCC_ExeOutput>..\Build\Bpl\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_UnitSearchPath>..\Source\Core;..\Source\DesignSystem;..\Source\Skia;..\Source\Controls;..\Source\Hooks;..\Source\DesignTime;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>System;Xml;Data;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UsePackage>rtl;designide;dbrtl;vcl;vclimg;Skia.Package.RTL;Skia.Package.VCL;$(DCC_UsePackage)</DCC_UsePackage>
        <GenPackage>true</GenPackage>
        <SanitizedProjectName>DACSkiaComponents</SanitizedProjectName>
        <GenDll>true</GenDll>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_UsePackage>vcldb;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1_Win32)'!=''">
        <VerInfo_Locale>1046</VerInfo_Locale>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <Target Name="WriteDacBuildProvenance">
        <MakeDir Directories="$(DAC_ProvenanceOutput)"/>
        <WriteLinesToFile File="$(DAC_ProvenanceOutput)\manifest.txt" Overwrite="true" Lines="project=$(MSBuildProjectName);configuration=$(Config);platform=$(Platform);bplOutput=$(DCC_BplOutput);dcpOutput=$(DCC_DcpOutput);dcuOutput=$(DCC_DcuOutput);cBuilderOutput=$(DCC_CBuilderOutput);legacyArtifacts=preserved"/>
    </Target>
    <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')"/>
</Project>
