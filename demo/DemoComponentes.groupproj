<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{27D279D8-7B84-4414-A5FD-FDA65B69ED76}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\Package\DACSkiaComponentsRuntime.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\Package\DACSkiaComponentsDesign.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Demo.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="DACSkiaComponentsRuntime">
        <MSBuild Projects="..\Package\DACSkiaComponentsRuntime.dproj"/>
    </Target>
    <Target Name="DACSkiaComponentsRuntime:Clean">
        <MSBuild Projects="..\Package\DACSkiaComponentsRuntime.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DACSkiaComponentsRuntime:Make">
        <MSBuild Projects="..\Package\DACSkiaComponentsRuntime.dproj" Targets="Make"/>
    </Target>
    <Target Name="DACSkiaComponentsDesign">
        <MSBuild Projects="..\Package\DACSkiaComponentsDesign.dproj"/>
    </Target>
    <Target Name="DACSkiaComponentsDesign:Clean">
        <MSBuild Projects="..\Package\DACSkiaComponentsDesign.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DACSkiaComponentsDesign:Make">
        <MSBuild Projects="..\Package\DACSkiaComponentsDesign.dproj" Targets="Make"/>
    </Target>
    <Target Name="Demo">
        <MSBuild Projects="Demo.dproj"/>
    </Target>
    <Target Name="Demo:Clean">
        <MSBuild Projects="Demo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Demo:Make">
        <MSBuild Projects="Demo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="DACSkiaComponentsRuntime;DACSkiaComponentsDesign;Demo"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="DACSkiaComponentsRuntime:Clean;DACSkiaComponentsDesign:Clean;Demo:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="DACSkiaComponentsRuntime:Make;DACSkiaComponentsDesign:Make;Demo:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
