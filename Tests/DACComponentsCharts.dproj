<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{F1ED9A32-3D8D-4E66-8B6D-BD8B816113A5}</ProjectGuid>
    <MainSource>DACComponentsCharts.dpr</MainSource>
    <ProjectVersion>18.3</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
  </PropertyGroup>
  <PropertyGroup>
    <Base>true</Base>
    <DCC_DcuOutput>..\Build\Dcu\$(Platform)\$(Config)\Tests\DACComponentsCharts</DCC_DcuOutput>
    <DCC_ExeOutput>..\Build\Exe\$(Platform)\$(Config)\Tests</DCC_ExeOutput>
    <DCC_CBuilderOutput>None</DCC_CBuilderOutput>
    <DAC_SkiaRuntimeSource>..\Build\Exe\Win32\$(Config)\sk4d.dll</DAC_SkiaRuntimeSource>
    <DCC_UnitSearchPath>..\Source\Core;..\Source\DesignSystem;..\Source\Skia;..\Source\Controls;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_UsePackage>rtl;vcl;vcldb;vclimg;Skia.Package.RTL;Skia.Package.VCL;$(DCC_UsePackage)</DCC_UsePackage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1><CfgParent>Base</CfgParent><Base>true</Base>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <BuildConfiguration Include="Base"><Key>Base</Key></BuildConfiguration>
    <BuildConfiguration Include="Debug"><Key>Cfg_1</Key><CfgParent>Base</CfgParent></BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions><Borland.Personality>Delphi.Personality.12</Borland.Personality><BorlandProject><Delphi.Personality><Source><Source Name="MainSource">DACComponentsCharts.dpr</Source></Source></Delphi.Personality><Platforms><Platform value="Win32">True</Platform></Platforms></BorlandProject></ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
  <PropertyGroup><BuildDependsOn>$(BuildDependsOn);CopySkiaRuntimeForChartsTests</BuildDependsOn></PropertyGroup>
  <Target Name="CopySkiaRuntimeForChartsTests">
    <Error Condition="!Exists('$(DAC_SkiaRuntimeSource)')" Text="sk4d.dll nao foi encontrada em $(DAC_SkiaRuntimeSource)."/>
    <Copy SourceFiles="$(DAC_SkiaRuntimeSource)" DestinationFiles="$(DCC_ExeOutput)\sk4d.dll"/>
  </Target>
</Project>
